generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model activities {
  id             Int                       @id @default(autoincrement())
  recipient_id   Int?
  recipient_type activities_recipient_type
  type           activities_type
  title          String                    @db.VarChar(255)
  description    String                    @db.Text
  created_at     DateTime?                 @default(now()) @db.DateTime(0)
  members        members?                  @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_activities")

  @@index([recipient_id], map: "fk_member_activities")
}

model attendance {
  id               Int                @id @default(autoincrement())
  member_id        Int
  session_id       String             @db.VarChar(36)
  check_in_time    DateTime           @default(now()) @db.DateTime(0)
  status           attendance_status? @default(PRESENT)
  members          members            @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member")
  checkin_sessions checkin_sessions   @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_session")

  @@unique([member_id, session_id], map: "unique_member_session")
  @@index([session_id], map: "fk_session")
}

model checkin_sessions {
  id         String       @id @db.VarChar(36)
  created_at DateTime     @default(now()) @db.DateTime(0)
  expires_at DateTime     @db.DateTime(0)
  is_active  Boolean      @default(true)
  attendance attendance[]
}

model member_activations {
  id              Int       @id @default(autoincrement())
  member_id       Int
  activation_code String    @db.VarChar(10)
  expires_at      DateTime  @db.DateTime(0)
  is_used         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.Timestamp(0)
  members         members   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_activations")

  @@index([member_id], map: "fk_member_activations")
}

model member_workout_exercises {
  id              Int             @id @default(autoincrement())
  workout_id      Int
  exercise_name   String          @db.VarChar(150)
  sets            Int
  reps            Int
  weight          Decimal         @db.Decimal(6, 2)
  member_workouts member_workouts @relation(fields: [workout_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_workouts_exercises")

  @@index([workout_id], map: "fk_member_workouts_exercises")
}

model member_workouts {
  id                       Int                        @id @default(autoincrement())
  member_id                Int
  workout_name             String                     @db.VarChar(150)
  duration_minutes         Int
  calories_burned          Int
  completed_at             DateTime?                  @default(now()) @db.DateTime(0)
  member_workout_exercises member_workout_exercises[]
  members                  members                    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_workouts")

  @@index([member_id], map: "fk_member_workouts")
}

model members {
  id                                       Int                  @id @default(autoincrement())
  user_id                                  Int?                 @unique(map: "user_id")
  fullname                                 String               @db.VarChar(100)
  email                                    String               @unique(map: "email") @db.VarChar(255)
  age                                      Int
  gender                                   members_gender
  plan_id                                  Int
  status                                   members_status       @default(Active)
  is_activated                             Boolean              @default(false)
  points                                   Int
  referral_code                            String               @unique(map: "referral_code") @db.VarChar(255)
  join_date                                DateTime?            @default(now()) @db.Timestamp(0)
  updated_at                               DateTime?            @default(now()) @db.Timestamp(0)
  activities                               activities[]
  attendance                               attendance[]
  body_progress                            body_progress[]
  fitness_goals                            fitness_goals[]
  member_activations                       member_activations[]
  member_memberships                       member_memberships[]
  member_workouts                          member_workouts[]
  membership_plans                         membership_plans     @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_members_plan")
  users                                    users?               @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_members_user")
  notifications                            notifications[]
  payments                                 payments[]
  post_comments                            post_comments[]
  post_likes                               post_likes[]
  posts                                    posts[]
  referrals_referrals_referee_idTomembers  referrals?           @relation("referrals_referee_idTomembers")
  referrals_referrals_referrer_idTomembers referrals[]          @relation("referrals_referrer_idTomembers")
  reward_redemptions                       reward_redemptions[]

  @@index([plan_id], map: "fk_members_plan")
}

model membership_plans {
  id                 Int                            @id @default(autoincrement())
  plan_name          String                         @db.VarChar(100)
  price              Decimal                        @db.Decimal(10, 2)
  duration           Int
  duration_type      membership_plans_duration_type
  created_at         DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                      @default(now()) @db.Timestamp(0)
  member_memberships member_memberships[]
  members            members[]
}

model notifications {
  id             Int                          @id @default(autoincrement())
  recipient_id   Int?
  recipient_type notifications_recipient_type
  type           notifications_type
  title          String                       @db.VarChar(255)
  description    String?                      @db.Text
  is_read        Boolean?                     @default(false)
  created_at     DateTime?                    @default(now()) @db.DateTime(0)
  members        members?                     @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_notifications")

  @@index([recipient_id], map: "fk_member_notifications")
}

model otp_codes {
  id        Int               @id @default(autoincrement())
  user_id   Int
  code      String            @db.VarChar(10)
  purpose   otp_codes_purpose
  expiresAt DateTime          @db.DateTime(0)
  used      Boolean?          @default(false)
  createdAt DateTime?         @default(now()) @db.Timestamp(0)
  users     users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_otp")

  @@index([user_id], map: "fk_otp")
}

model payments {
  id                 Int                      @id @default(autoincrement())
  member_id          Int
  membership_id      Int
  amount             Decimal                  @db.Decimal(10, 2)
  payment_method     payments_payment_method?
  status             payments_status?         @default(Pending)
  paid_at            DateTime?                @db.DateTime(0)
  created_at         DateTime?                @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                @default(now()) @db.Timestamp(0)
  members            members                  @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_payment_member")
  member_memberships member_memberships       @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_payment_membership")

  @@index([member_id], map: "fk_payment_member")
  @@index([membership_id], map: "fk_payment_membership")
}

model post_comments {
  id         Int       @id @default(autoincrement())
  post_id    Int
  member_id  Int
  comment    String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  members    members   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_post_comments_member")
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_post_comments_post")

  @@index([member_id], map: "fk_post_comments_member")
  @@index([post_id], map: "fk_post_comments_post")
}

model post_images {
  id         Int       @id @default(autoincrement())
  post_id    Int
  image_url  String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_post_images_post")

  @@index([post_id], map: "fk_post_images_post")
}

model post_likes {
  id         Int       @id @default(autoincrement())
  post_id    Int
  member_id  Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  members    members   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_post_likes_member")
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_post_likes_post")

  @@unique([post_id, member_id], map: "uq_post_likes_member_post")
  @@index([member_id], map: "fk_post_likes_member")
}

model posts {
  id            Int             @id @default(autoincrement())
  member_id     Int
  content       String?         @db.Text
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @default(now()) @db.Timestamp(0)
  post_comments post_comments[]
  post_images   post_images[]
  post_likes    post_likes[]
  members       members         @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_posts_member")

  @@index([member_id], map: "fk_posts_member")
}

model rewards {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  description        String               @db.Text
  points_required    Int
  category           String               @db.VarChar(255)
  total_claim        Int
  createdAt          DateTime?            @default(now()) @db.Timestamp(0)
  updatedAt          DateTime?            @default(now()) @db.Timestamp(0)
  reward_redemptions reward_redemptions[]
}

model tutorials {
  id               Int             @id @default(autoincrement())
  name             String          @db.VarChar(255)
  category         String          @db.VarChar(255)
  level            tutorials_level
  video_url        String          @db.VarChar(500)
  instructions     String          @db.Text
  equipment        String          @db.LongText
  muscles_targeted String          @db.LongText
  demo_images      String          @db.LongText
  created_at       DateTime?       @default(now()) @db.Timestamp(0)
  updated_at       DateTime?       @default(now()) @db.Timestamp(0)
}

model users {
  id        Int         @id @default(autoincrement())
  username  String      @db.VarChar(255)
  email     String      @unique(map: "email") @db.VarChar(255)
  password  String      @db.VarChar(255)
  contact   String?     @db.VarChar(11)
  hash_pass String      @db.Text
  profile   String?     @db.VarChar(255)
  role      users_role  @default(MEMBER)
  createdAt DateTime?   @default(now()) @db.Timestamp(0)
  updatedAt DateTime?   @default(now()) @db.Timestamp(0)
  members   members?
  otp_codes otp_codes[]
}

model member_memberships {
  id               Int                        @id @default(autoincrement())
  member_id        Int
  plan_id          Int
  start_date       DateTime                   @db.Date
  end_date         DateTime                   @db.Date
  status           member_memberships_status? @default(Active)
  created_at       DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at       DateTime?                  @default(now()) @db.Timestamp(0)
  members          members                    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_membership_member")
  membership_plans membership_plans           @relation(fields: [plan_id], references: [id], onUpdate: Restrict, map: "fk_member_membership_plan")
  payments         payments[]

  @@index([member_id], map: "fk_member_membership_member")
  @@index([plan_id], map: "fk_member_membership_plan")
}

model reward_redemptions {
  id          Int                        @id @default(autoincrement())
  member_id   Int
  reward_id   Int
  points_used Int
  status      reward_redemptions_status? @default(Pending)
  redeemed_at DateTime?                  @default(now()) @db.Timestamp(0)
  members     members                    @relation(fields: [member_id], references: [id], onUpdate: Restrict, map: "1")
  rewards     rewards                    @relation(fields: [reward_id], references: [id], onUpdate: Restrict, map: "2")

  @@index([member_id], map: "fk_reward_member_redeemed")
  @@index([reward_id], map: "fk_reward_redeemed")
}

model body_progress {
  id                  Int           @id @default(autoincrement())
  goal_id             Int
  member_id           Int
  previous_weight     Decimal       @db.Decimal(5, 2)
  current_weight      Decimal       @db.Decimal(5, 2)
  target_weight       Decimal       @db.Decimal(5, 2)
  progress_percentage Decimal       @default(0.00) @db.Decimal(5, 2)
  weight_change       Decimal       @default(0.00) @db.Decimal(5, 2)
  recorded_at         DateTime?     @default(now()) @db.DateTime(0)
  fitness_goals       fitness_goals @relation(fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_progress_goal")
  members             members       @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_progress_member")

  @@index([goal_id], map: "fk_progress_goal")
  @@index([member_id], map: "fk_progress_member")
}

model fitness_goals {
  id             Int                     @id @default(autoincrement())
  member_id      Int
  goal_type      fitness_goals_goal_type
  status         fitness_goals_status    @default(ACTIVE)
  start_weight   Decimal                 @db.Decimal(5, 2)
  current_weight Decimal                 @db.Decimal(5, 2)
  target_weight  Decimal                 @db.Decimal(5, 2)
  completed_at   DateTime?               @db.DateTime(0)
  created_at     DateTime?               @default(now()) @db.DateTime(0)
  updated_at     DateTime?               @default(now()) @db.DateTime(0)
  body_progress  body_progress[]
  members        members                 @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_goal_member")

  @@index([member_id], map: "fk_goal_member")
}

model referrals {
  id                                     Int       @id @default(autoincrement())
  referrer_id                            Int
  referee_id                             Int       @unique(map: "referee_id")
  referrer_points                        Int
  referee_points                         Int
  referred_at                            DateTime? @default(now()) @db.Timestamp(0)
  members_referrals_referee_idTomembers  members   @relation("referrals_referee_idTomembers", fields: [referee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_referee")
  members_referrals_referrer_idTomembers members   @relation("referrals_referrer_idTomembers", fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_referrer")

  @@index([referrer_id], map: "fk_referrer")
}

enum tutorials_level {
  Beginner
  Intermediate
  Advanced
}

enum otp_codes_purpose {
  LOGIN
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum attendance_status {
  PRESENT
}

enum membership_plans_duration_type {
  Week
  Month
  Day
}

enum members_gender {
  Male
  Female
}

enum users_role {
  ADMIN
  MEMBER
}

enum members_status {
  Inactive
  Active
  Suspended
}

enum payments_payment_method {
  Cash
  GCash
  Bank_Transfer @map("Bank Transfer")
}

enum member_memberships_status {
  Active
  Expired
  Cancelled
}

enum payments_status {
  Pending
  Paid
  Cancelled
  Refunded
}

enum reward_redemptions_status {
  Pending
  Claimed
  Cancelled
}

enum activities_recipient_type {
  ADMIN
  MEMBER
}

enum notifications_recipient_type {
  ADMIN
  MEMBER
}

enum activities_type {
  MEMBER
  CHECK_IN
  PAYMENT
  REWARD
  REGISTER
}

enum notifications_type {
  CHECK_IN
  PAYMENT
  REWARD
  EXPIRY
  REMINDER
}

enum fitness_goals_goal_type {
  LOSE_WEIGHT
  GAIN_WEIGHT
}

enum fitness_goals_status {
  ACHIEVED
  ACTIVE
}
